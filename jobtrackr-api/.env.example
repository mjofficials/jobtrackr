# Postgres connection string (Supabase: Project Settings → Database → Connection string)
DATABASE_URL="postgresql://postgres:<password>@<host>:5432/postgres"

# Secret used to sign JWTs — generate with: openssl rand -hex 32
JWT_SECRET="change-me"

# API port
PORT=4000

# Comma-separated list of allowed frontend origins
CORS_ORIGIN="http://localhost:3000"

# Claude API key for the AI features (https://console.anthropic.com). Leave empty to use the built-in mock.
ANTHROPIC_API_KEY=""
